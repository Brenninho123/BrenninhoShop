---
interface Product {
  id: string;
  name: string;
  price: number;
  category: string;
  description: string;
  image: string;
}

interface Project {
  name: string;
  title: string;
  description: string;
  lang: string;
  locale: string;
  currency: string;
  themeColor: string;
  accent: string;
  background: string;
  surface: string;
  whatsapp: string;
  storageKey: string;
  products: Product[];
}

const { project } = Astro.props as { project: Project };
const { products } = project;
const categories = ["All", ...new Set(products.map((p) => p.category))];
const format = (value: number) =>
  value.toLocaleString(project.locale, {
    style: "currency",
    currency: project.currency,
  });
---

<!doctype html>
<html lang={project.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={project.themeColor} />
    <meta name="description" content={project.description} />
    <title>{project.title}</title>
  </head>
  <body
    data-phone={project.whatsapp}
    data-storage={project.storageKey}
    data-locale={project.locale}
    data-currency={project.currency}
  >
    <header class="top">
      <strong>{project.name}</strong>
      <button id="cart-open" class="cart-btn">
        Cart <span id="cart-count">0</span>
      </button>
    </header>

    <main class="wrap">
      <div class="tools">
        <input id="search" type="search" placeholder="Search products..." />
        <select id="sort">
          <option value="default">Featured</option>
          <option value="low">Price: low to high</option>
          <option value="high">Price: high to low</option>
          <option value="name">Name</option>
        </select>
      </div>

      <div class="filters">
        {
          categories.map((c) => (
            <button class={c === "All" ? "chip active" : "chip"} data-category={c}>
              {c}
            </button>
          ))
        }
      </div>

      <section id="grid" class="grid">
        {
          products.map((p, index) => (
            <article
              class="card"
              data-id={p.id}
              data-name={p.name}
              data-price={p.price}
              data-category={p.category}
              data-order={index}
            >
              <img src={p.image} alt={p.name} loading="lazy" />
              <div class="info">
                <h3>{p.name}</h3>
                <p class="desc">{p.description}</p>
                <div class="row">
                  <span class="price">{format(p.price)}</span>
                  <button class="add" data-add={p.id}>Add</button>
                </div>
              </div>
            </article>
          ))
        }
      </section>

      <p id="empty" hidden>No products found.</p>
    </main>

    <div id="toast" class="toast"></div>
    <div id="overlay" class="overlay"></div>

    <aside id="drawer" class="drawer">
      <div class="drawer-head">
        <strong>Your cart</strong>
        <button id="cart-close" class="chip">Close</button>
      </div>
      <div id="cart-list" class="cart-list"></div>
      <div class="drawer-foot">
        <div class="total">
          <span>Total</span>
          <strong id="cart-total">R$ 0,00</strong>
        </div>
        <button id="checkout" class="checkout">Checkout on WhatsApp</button>
        <button id="clear" class="link">Clear cart</button>
      </div>
    </aside>
  </body>
</html>

<style
  is:global
  define:vars={{ accent: project.accent, bg: project.background, card: project.surface }}
>
  :root {
    --text: #f2f2f5;
    --muted: #9a9aa8;
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, sans-serif;
  }
  button,
  select {
    font: inherit;
    color: var(--text);
  }
  button {
    cursor: pointer;
    border: none;
  }
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1rem;
    background: var(--card);
  }
  .cart-btn {
    background: var(--accent);
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
  }
  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  .tools {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  #search {
    flex: 1;
    min-width: 200px;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1px solid #333;
    background: var(--card);
    color: var(--text);
    font-size: 1rem;
  }
  #sort {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    border: 1px solid #333;
    background: var(--card);
  }
  .filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 1rem 0;
  }
  .chip {
    background: var(--card);
    padding: 0.45rem 1rem;
    border-radius: 999px;
  }
  .chip.active {
    background: var(--accent);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .card {
    background: var(--card);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.15s;
  }
  .card:hover {
    transform: translateY(-4px);
  }
  .card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }
  .info {
    padding: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .desc {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.3rem;
  }
  .price {
    color: var(--accent);
    font-weight: 700;
  }
  .add {
    background: var(--accent);
    padding: 0.4rem 0.9rem;
    border-radius: 8px;
  }
  #empty {
    text-align: center;
    color: var(--muted);
    margin-top: 2rem;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translate(-50%, 200%);
    background: var(--card);
    border: 1px solid var(--accent);
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    transition: transform 0.25s;
    z-index: 20;
  }
  .toast.show {
    transform: translate(-50%, 0);
  }
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    z-index: 10;
  }
  .overlay.open {
    opacity: 1;
    pointer-events: auto;
  }
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: min(380px, 100%);
    background: var(--card);
    transform: translateX(100%);
    transition: transform 0.25s;
    z-index: 11;
    display: flex;
    flex-direction: column;
  }
  .drawer.open {
    transform: translateX(0);
  }
  .drawer-head,
  .drawer-foot {
    padding: 1rem;
  }
  .drawer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cart-list {
    flex: 1;
    overflow-y: auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg);
    padding: 0.6rem 0.8rem;
    border-radius: 10px;
  }
  .qty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .qty button {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--card);
  }
  .total {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
  }
  .checkout {
    width: 100%;
    background: #25d366;
    color: #06210f;
    font-weight: 700;
    padding: 0.8rem;
    border-radius: 10px;
  }
  .link {
    width: 100%;
    background: none;
    color: var(--muted);
    margin-top: 0.6rem;
  }
  .empty-cart {
    text-align: center;
    color: var(--muted);
    padding: 2rem 0;
  }
</style>

<script>
  type CartItem = { id: string; name: string; price: number; qty: number };

  const config = document.body.dataset;
  const storageKey = config.storage ?? "cart";
  const phone = config.phone ?? "";
  const money = new Intl.NumberFormat(config.locale ?? "en-US", {
    style: "currency",
    currency: config.currency ?? "USD",
  });

  const search = document.getElementById("search") as HTMLInputElement;
  const sort = document.getElementById("sort") as HTMLSelectElement;
  const grid = document.getElementById("grid") as HTMLElement;
  const chips = document.querySelectorAll<HTMLButtonElement>(".filters .chip");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".card"));
  const empty = document.getElementById("empty") as HTMLElement;
  const drawer = document.getElementById("drawer") as HTMLElement;
  const overlay = document.getElementById("overlay") as HTMLElement;
  const list = document.getElementById("cart-list") as HTMLElement;
  const totalEl = document.getElementById("cart-total") as HTMLElement;
  const countEl = document.getElementById("cart-count") as HTMLElement;
  const toast = document.getElementById("toast") as HTMLElement;

  let category = "All";
  let toastTimer = 0;

  const load = (): CartItem[] => {
    try {
      const parsed = JSON.parse(localStorage.getItem(storageKey) ?? "[]");
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  };

  let cart = load();

  const save = () => {
    try {
      localStorage.setItem(storageKey, JSON.stringify(cart));
    } catch {
      return;
    }
  };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return map[c];
    });

  const showToast = (message: string) => {
    toast.textContent = message;
    toast.classList.add("show");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("show"), 1400);
  };

  const applyFilters = () => {
    const term = search.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const nameOk = (card.dataset.name ?? "").toLowerCase().includes(term);
      const categoryOk = category === "All" || card.dataset.category === category;
      const show = nameOk && categoryOk;
      card.style.display = show ? "" : "none";
      if (show) visible++;
    });

    empty.hidden = visible > 0;
  };

  const applySort = () => {
    const mode = sort.value;
    const sorted = [...cards].sort((a, b) => {
      if (mode === "low") return Number(a.dataset.price) - Number(b.dataset.price);
      if (mode === "high") return Number(b.dataset.price) - Number(a.dataset.price);
      if (mode === "name") return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
      return Number(a.dataset.order) - Number(b.dataset.order);
    });
    sorted.forEach((card) => grid.appendChild(card));
  };

  const cartTotal = () => cart.reduce((sum, item) => sum + item.qty * item.price, 0);

  const renderCart = () => {
    const count = cart.reduce((sum, item) => sum + item.qty, 0);
    countEl.textContent = String(count);
    totalEl.textContent = money.format(cartTotal());

    if (cart.length === 0) {
      list.innerHTML = '<p class="empty-cart">Your cart is empty.</p>';
      return;
    }

    list.innerHTML = cart
      .map(
        (item) => `
        <div class="cart-item">
          <div>
            <div>${escapeHtml(item.name)}</div>
            <small>${money.format(item.price)}</small>
          </div>
          <div class="qty">
            <button data-action="dec" data-id="${escapeHtml(item.id)}">-</button>
            <span>${item.qty}</span>
            <button data-action="inc" data-id="${escapeHtml(item.id)}">+</button>
          </div>
        </div>`
      )
      .join("");
  };

  const update = () => {
    save();
    renderCart();
  };

  const toggleDrawer = (open: boolean) => {
    drawer.classList.toggle("open", open);
    overlay.classList.toggle("open", open);
  };

  const addToCart = (id: string) => {
    const card = cards.find((c) => c.dataset.id === id);
    if (!card) return;

    const existing = cart.find((item) => item.id === id);
    if (existing) {
      existing.qty++;
    } else {
      cart.push({
        id,
        name: card.dataset.name ?? "",
        price: Number(card.dataset.price ?? 0),
        qty: 1,
      });
    }

    update();
    showToast(`${card.dataset.name} added`);
  };

  search.addEventListener("input", applyFilters);
  sort.addEventListener("change", applySort);

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      category = chip.dataset.category ?? "All";
      chips.forEach((c) => c.classList.toggle("active", c === chip));
      applyFilters();
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-add]").forEach((button) => {
    button.addEventListener("click", () => addToCart(button.dataset.add ?? ""));
  });

  list.addEventListener("click", (event) => {
    const target = (event.target as HTMLElement).closest<HTMLButtonElement>("button");
    if (!target) return;

    const item = cart.find((i) => i.id === target.dataset.id);
    if (!item) return;

    item.qty += target.dataset.action === "inc" ? 1 : -1;
    cart = cart.filter((i) => i.qty > 0);
    update();
  });

  document.getElementById("cart-open")?.addEventListener("click", () => toggleDrawer(true));
  document.getElementById("cart-close")?.addEventListener("click", () => toggleDrawer(false));
  overlay.addEventListener("click", () => toggleDrawer(false));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") toggleDrawer(false);
  });

  document.getElementById("clear")?.addEventListener("click", () => {
    cart = [];
    update();
  });

  document.getElementById("checkout")?.addEventListener("click", () => {
    if (cart.length === 0) return;

    const lines = cart.map(
      (item) => `${item.qty}x ${item.name} - ${money.format(item.price * item.qty)}`
    );
    const message = `Hi! I want to order:\n${lines.join("\n")}\nTotal: ${money.format(cartTotal())}`;
    window.open(`https://wa.me/${phone}?text=${encodeURIComponent(message)}`, "_blank");
  });

  renderCart();
  applyFilters();
</script>
